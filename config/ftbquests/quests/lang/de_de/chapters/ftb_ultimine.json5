{
  "quest.071F41A6A13DBC7A.title": "Ultimine",
  "quest.071F41A6A13DBC7A.quest_desc": [
    "Mit Ultimine baust du ganze Erzadern, Bäume oder Flächen auf einmal ab. Halte dazu die Ultimine-Taste gedrückt, während du einen Block abbaust.",
    "",
    "Die Taste legst du in den Steuerungs-Einstellungen unter 'FTB Ultimine' fest."
  ],
  "quest.44B09BF7A0579089.title": "Die Form wählen",
  "quest.44B09BF7A0579089.quest_desc": [
    "Mit Ultimine gibt es verschiedene Formen (zum Beispiel Schacht oder Fläche). Du wechselst sie mit den Tasten, die du in den Einstellungen siehst.",
    "",
    "Je mehr Blöcke du auf einmal abbaust, desto mehr Hunger bekommst du und desto schneller nutzt sich dein Werkzeug ab."
  ]
}
