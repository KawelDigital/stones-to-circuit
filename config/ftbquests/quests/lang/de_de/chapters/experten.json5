{
  "quest.3AB7F1E8A6DE5375.title": "Willkommen im Experten-Kapitel",
  "quest.3AB7F1E8A6DE5375.quest_desc": [
    "Hier gibt es keine Schritt-für-Schritt-Anleitung. Du bekommst Ideen und Herausforderungen, mit denen du alle Mods des Packs kombinierst."
  ],
  "quest.1AD1F57EFF64CF29.title": "Die vollautomatische Fabrik",
  "quest.1AD1F57EFF64CF29.quest_desc": [
    "Baue eine Fabrik, die ein Produkt vollautomatisch herstellt: Eingang aus dem Netzwerkspeicher, Ausgang in ein Lager. Nutze dafür den Auto-Crafter, den Drucker und einen Computer als Steuerung."
  ],
  "quest.45DE4ADD62DCBD83.title": "Eine Turtle baut ein Schloss",
  "quest.45DE4ADD62DCBD83.quest_desc": [
    "Auf jeder Turtle gibt es die Programme 'villa' (ein Gebäude mit Untergrund-Labor) und 'schloss' (ein gigantisches modernes Schloss). Die Turtle holt sich Kohle und Material selbst aus deinem Netzwerkspeicher.",
    "",
    "Du brauchst eine Turtle mit Spitzhacke und Ender-Modem, einen Speicher am Netz (am besten den Creative-Speicher) und einen freien ebenen Platz. Starte mit: schloss 1 (oder 2/3 für mehr).",
    "",
    "Der Bau dauert lange. Mit dem Befehl /tick rate 200 (Operator) geht es schneller. Danach unbedingt /tick rate 20."
  ],
  "quest.7A8627EDA7B13E75.title": "AE2 und CC kombinieren",
  "quest.7A8627EDA7B13E75.quest_desc": [
    "Lasse einen Computer die Mengen in deinem AE2-Netz überwachen und warnen, wenn etwas knapp wird. Mit Lua und passenden Peripherals gibt es viele Möglichkeiten."
  ],
  "quest.5A17925DD7369F79.title": "Die Turtle-Flotte",
  "quest.5A17925DD7369F79.quest_desc": [
    "Bau mehrere Turtles, die über das Ender-Modem Aufträge bekommen und ihre Funde abgeben. Eine Zentrale (Computer) verteilt die Aufgaben."
  ],
  "quest.40ECDA4FD89F08C0.title": "Eigene Programme teilen",
  "quest.40ECDA4FD89F08C0.quest_desc": [
    "Programme sind nur Textdateien. Tausche sie mit Freunden über Disketten oder pastebin."
  ]
}
