{
  "quest.46ADE618716A8865.title": "Teams",
  "quest.46ADE618716A8865.quest_desc": [
    "Mit FTB Teams spielst du gemeinsam mit Freunden: Alle im Team teilen Quest-Fortschritt, Chunk-Claims und mehr."
  ],
  "quest.6DCDBBB0F0F42E84.title": "Ein Team gründen",
  "quest.6DCDBBB0F0F42E84.quest_desc": [
    "Öffne die Team-Verwaltung (der Knopf liegt im Inventar-Bildschirm links oben) und gründe ein Team.",
    "",
    "Dort lädst du auch Freunde ein. Ein Team ist wie eine gemeinsame Kasse für deine Basis."
  ],
  "quest.6FDEC536D0F33076.title": "Einen Freund einladen",
  "quest.6FDEC536D0F33076.quest_desc": [
    "Lade deinen Freund in dein Team ein. Er muss die Einladung im Chat oder im Team-Menü annehmen."
  ]
}
