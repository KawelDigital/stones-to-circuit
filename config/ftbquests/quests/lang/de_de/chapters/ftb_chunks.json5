{
  "quest.6079EEE3B3E24285.title": "Die Karte",
  "quest.6079EEE3B3E24285.quest_desc": [
    "FTB Chunks bringt eine Karte mit. Die kleine Minikarte siehst du in der Ecke. Die große Karte öffnest du mit der Taste M.",
    "",
    "Auf der großen Karte kannst du Chunks (16x16-Blöcke) anklicken und beanspruchen."
  ],
  "quest.2B5F74B31FD0765A.title": "Land beanspruchen",
  "quest.2B5F74B31FD0765A.quest_desc": [
    "Öffne die große Karte und klicke Chunks an, die du für dich beanspruchen willst. Dein Land ist dann vor fremdem Abbauen und Explosionen geschützt.",
    "",
    "Es gibt ein Limit für die Anzahl der Chunks. Wähle deshalb mit Bedacht."
  ],
  "quest.20106725116A4355.title": "Chunks geladen halten",
  "quest.20106725116A4355.quest_desc": [
    "Normalerweise arbeiten Maschinen nur, solange du in der Nähe bist. Mit FTB Chunks kannst du Chunks 'force-loaden': Sie bleiben aktiv, auch wenn du weit weg bist.",
    "",
    "Das ist wichtig für Turtles, Fabriken und Computer, die in deiner Abwesenheit weiterlaufen sollen."
  ]
}
